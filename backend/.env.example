# ── LLM Providers ────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here_account1,your_groq_api_key_here_account2,your_groq_api_key_here_account3 
GEMINI_API_KEY=your_gemini_api_key_here_account1,your_gemini_api_key_here_account2

# Model names (free-tier friendly defaults — change if you want)
GROQ_MODEL=qwen/qwen3.8-27b
GEMINI_MODEL=gemini-3.8-flash

# ── Search ───────────────────────────────────────────────────
TAVILY_API_KEY=your_tavily_api_key_here

# ── Database (local Postgres you already have running) ───────
DATABASE_URL=postgresql://postgres:password@localhost:5432/narrative_engine

GUARDIAN_API_KEY=your_guardian_api_key_here

# ── App ──────────────────────────────────────────────────────
ENV=development
LOG_LEVEL=INFO
